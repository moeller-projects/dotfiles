# --------------------------------
# Angular / JS toolchain
# --------------------------------

prefix_rule(
  pattern = ["ng", ["build", "test", "e2e", "serve"]],
  decision = "forbidden",
  justification = "Do not run Angular build, test, e2e, or dev server commands unless the user explicitly asks.",
)

prefix_rule(
  pattern = ["yarn", ["build", "test", "start", "dev"]],
  decision = "forbidden",
  justification = "Do not run Yarn build, test, start, or dev commands unless the user explicitly asks.",
)

prefix_rule(
  pattern = ["yarn", "run", ["build", "test", "start", "dev", "serve", "e2e"]],
  decision = "forbidden",
  justification = "Do not run Yarn scripts that build, test, or launch apps unless the user explicitly asks.",
)

prefix_rule(
  pattern = ["bun", "test"],
  decision = "forbidden",
  justification = "Do not run Bun tests unless the user explicitly asks.",
)

prefix_rule(
  pattern = ["bun", "run", ["build", "test", "start", "dev", "serve", "e2e"]],
  decision = "forbidden",
  justification = "Do not run Bun scripts that build, test, or launch apps unless the user explicitly asks.",
)

# --------------------------------
# .NET
# --------------------------------

prefix_rule(
  pattern = ["dotnet", ["build", "test", "run", "publish", "watch"]],
  decision = "forbidden",
  justification = "Do not build, test, run, publish, or watch .NET apps unless the user explicitly asks.",
)

# --------------------------------
# Common alternate runners often present in Angular repos
# --------------------------------

prefix_rule(
  pattern = ["npx", ["ng", "nx", "jest", "vitest", "playwright", "cypress"]],
  decision = "prompt",
  justification = "npx can launch build/test tooling indirectly. Review before allowing.",
)

prefix_rule(
  pattern = ["pnpm", ["build", "test", "start", "dev"]],
  decision = "forbidden",
  justification = "Do not run pnpm build, test, start, or dev commands unless the user explicitly asks.",
)

prefix_rule(
  pattern = ["npm", ["run", "test", "start"]],
  decision = "prompt",
  justification = "npm may invoke build or test scripts indirectly. Review before allowing.",
)

# --------------------------------
# Shell wrappers
# --------------------------------

prefix_rule(
  pattern = ["bash", ["-c", "-lc"]],
  decision = "prompt",
  justification = "Shell-wrapped commands can hide builds, tests, or servers. Review before allowing.",
)

prefix_rule(
  pattern = ["sh", "-c"],
  decision = "prompt",
  justification = "Shell-wrapped commands can hide builds, tests, or servers. Review before allowing.",
)

prefix_rule(
  pattern = ["zsh", ["-c", "-lc"]],
  decision = "prompt",
  justification = "Shell-wrapped commands can hide builds, tests, or servers. Review before allowing.",
)

# --------------------------------
# Project-local scripts
# --------------------------------

prefix_rule(
  pattern = ["./scripts/"],
  decision = "prompt",
  justification = "Project scripts may run builds or tests. Review before allowing.",
)

prefix_rule(
  pattern = ["scripts/"],
  decision = "prompt",
  justification = "Project scripts may run builds or tests. Review before allowing.",
)

# --------------------------------
# Task runners / CI-style entry points
# --------------------------------

prefix_rule(
  pattern = ["make"],
  decision = "prompt",
  justification = "Make targets often build or test. Review before allowing.",
)

prefix_rule(
  pattern = ["just"],
  decision = "prompt",
  justification = "Just recipes often build or test. Review before allowing.",
)

prefix_rule(
  pattern = ["task"],
  decision = "prompt",
  justification = "Task runner commands may invoke builds or tests. Review before allowing.",
)

# --------------------------------
# OpenSpec CLI
# Official docs: docs/cli.md
# --------------------------------

prefix_rule(
  pattern = ["openspec", ["--version", "-V", "--help", "-h"]],
  decision = "allow",
  justification = "Allow safe OpenSpec version/help inspection.",
)

prefix_rule(
  pattern = ["openspec", ["list", "show", "validate", "status", "instructions", "templates", "schemas"]],
  decision = "allow",
  justification = "Allow agent-compatible OpenSpec inspection, validation, status, templates, schemas, and instruction commands.",
)

prefix_rule(
  pattern = ["openspec", "schema", ["validate", "which"]],
  decision = "allow",
  justification = "Allow safe OpenSpec schema validation and schema source inspection.",
)

prefix_rule(
  pattern = ["openspec", "config", ["path", "list", "get"]],
  decision = "allow",
  justification = "Allow read-only OpenSpec configuration inspection.",
)

prefix_rule(
  pattern = ["openspec", "completion", "generate"],
  decision = "allow",
  justification = "Allow generating shell completion output without installing it.",
)

prefix_rule(
  pattern = ["openspec", ["init", "update", "archive"]],
  decision = "prompt",
  justification = "OpenSpec setup/update/archive commands can create, rewrite, move, or merge project files. Review before allowing.",
)

prefix_rule(
  pattern = ["openspec", "schema", ["init", "fork"]],
  decision = "prompt",
  justification = "OpenSpec schema creation/forking writes project-local schema files. Review before allowing.",
)

prefix_rule(
  pattern = ["openspec", "config", ["set", "unset", "reset", "edit", "profile"]],
  decision = "prompt",
  justification = "OpenSpec config modification can change global/project behavior or open an editor. Review before allowing.",
)

prefix_rule(
  pattern = ["openspec", "completion", ["install", "uninstall"]],
  decision = "prompt",
  justification = "Installing or uninstalling shell completions modifies shell configuration. Review before allowing.",
)

prefix_rule(
  pattern = ["openspec", ["view", "feedback"]],
  decision = "prompt",
  justification = "Interactive OpenSpec commands or commands requiring external tools/accounts should be reviewed.",
)

# --------------------------------
# Safe read-only shell utilities
# --------------------------------

prefix_rule(
  pattern = ["sort"],
  decision = "allow",
  justification = "Allow sorting stdin or file content. Read-only utility.",
)

prefix_rule(
  pattern = ["jq"],
  decision = "allow",
  justification = "Allow JSON inspection/transformation. Read-only unless shell redirection is used, which is covered by shell-wrapper review rules.",
)

prefix_rule(
  pattern = ["find"],
  decision = "prompt",
  justification = "Find is usually read-only, but -exec can run arbitrary commands. Review before allowing.",
)

prefix_rule(
  pattern = ["find", "openspec/"],
  decision = "allow",
  justification = "Allow reading OpenSpec files with find in the project-local openspec directory.",
)

# --------------------------------
# RTK default fallback
# --------------------------------

prefix_rule(
  pattern = ["rtk"],
  decision = "prompt",
  justification = "RTK is a command proxy. Unknown subcommands may execute hidden operations. Review before allowing.",
)

prefix_rule(
  pattern = ["rtk", "proxy"],
  decision = "forbidden",
  justification = "rtk proxy can execute arbitrary shell commands and bypass all safeguards.",
)

# --------------------------------
# RTK high-risk proxies (forbidden)
# --------------------------------

prefix_rule(
  pattern = ["rtk", ["test", "err", "summary", "proxy"]],
  decision = "forbidden",
  justification = "RTK wrapper commands can execute hidden build, test, server, or arbitrary shell commands.",
)

prefix_rule(
  pattern = ["rtk", ["npm", "yarn", "pnpm", "bun"]],
  decision = "forbidden",
  justification = "RTK can proxy package manager commands that build, test, or mutate dependencies.",
)

prefix_rule(
  pattern = ["rtk", ["ng", "nx"]],
  decision = "forbidden",
  justification = "RTK can proxy Angular/Nx build, test, and dev server commands.",
)

prefix_rule(
  pattern = ["rtk", ["dotnet"]],
  decision = "forbidden",
  justification = "RTK can proxy .NET build, run, test, or publish commands.",
)

prefix_rule(
  pattern = ["rtk", ["make", "just", "task"]],
  decision = "forbidden",
  justification = "RTK can proxy task runners that execute builds or tests.",
)

prefix_rule(
  pattern = ["rtk", ["docker", "kubectl"]],
  decision = "forbidden",
  justification = "RTK can proxy container or cluster commands with external side effects.",
)

prefix_rule(
  pattern = ["rtk", ["curl", "wget"]],
  decision = "forbidden",
  justification = "RTK can proxy network commands that fetch or execute external content.",
)

prefix_rule(
  pattern = ["rtk", "git", ["add", "commit", "push", "pull", "reset", "clean", "checkout", "restore", "rebase", "merge"]],
  decision = "forbidden",
  justification = "RTK can proxy mutating Git commands.",
)

# --------------------------------
# RTK safe allowlist
# --------------------------------

prefix_rule(
  pattern = ["rtk", ["--version", "-V", "--help", "-h"]],
  decision = "allow",
  justification = "Allow safe RTK version/help inspection.",
)

prefix_rule(
  pattern = ["rtk", ["ls", "read", "smart", "find", "grep", "diff", "json", "deps", "log", "gain", "discover", "session"]],
  decision = "allow",
  justification = "Allow RTK read-only inspection commands.",
)

prefix_rule(
  pattern = ["rtk", "git", ["status", "diff", "log", "show", "branch"]],
  decision = "allow",
  justification = "Allow RTK read-only Git inspection.",
)
